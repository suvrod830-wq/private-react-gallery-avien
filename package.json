{
  "name": "personal-image-gallery",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A production-ready personal image gallery CMS. React + Vite + Tailwind, Aiven PostgreSQL + JWT auth, Cloudinary storage/CDN, Vercel serverless signed uploads.",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "create-admin": "node scripts/create-admin.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:aiven": "node scripts/test-aiven-db.mjs",
    "check:tables": "node scripts/check-aiven-tables.mjs",
    "check:schema": "node scripts/check-aiven-schema.mjs",
    "migrate:aiven": "node scripts/apply-migrations.mjs",
    "test:aiven:functions": "node scripts/test-aiven-functions.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.5.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.469.0",
    "pg": "^8.23.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "react-router-dom": "^7.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@hookform/resolvers": "^3.9.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "dotenv": "^16.4.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "express": "^4.22.3",
    "globals": "^15.14.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
