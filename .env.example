# ============================================================================
# Personal Image Gallery — Environment Variables
# ============================================================================
# Copy this file to `.env` (local dev) and configure the values there.
# NEVER commit `.env` — it is git-ignored.
#
# ⚠️ SECURITY: never put real credentials in this file template or access.md.
#    Both are committed to the repository.
#
# The app now runs entirely on AIVEN PostgreSQL + JWT auth. There is NO
# Supabase anywhere in the stack anymore.
#
# Groups:
#   VITE_*          → exposed to the browser (public, safe values only)
#   DATABASE_URL    → server-side only (Aiven PostgreSQL)
#   JWT_SECRET      → server-side only (signs auth tokens)
#   CLOUDINARY_*    → server-side only (except the cloud name)
# ----------------------------------------------------------------------------

# ----------------------------------------------------------------------------
# Database — AIVEN for PostgreSQL (server-side only, NEVER expose to browser)
# ----------------------------------------------------------------------------
# Aiven console → your PostgreSQL service → Connection information.
# Format:
#   postgres://<user>:<password>@<host>:<port>/<dbname>?sslmode=require
# Example:
#   postgres://avnadmin:xxxx@pg-1a2b3c4d-shuvrod564.l.aivencloud.com:12345/defaultdb?sslmode=require
DATABASE_URL=

# Set to "false" ONLY for a local PostgreSQL without TLS (tests / local dev).
# Leave unset (or "true") for Aiven, which requires TLS.
# DATABASE_SSL=false

# ----------------------------------------------------------------------------
# Auth — JWT signing secret (server-side only)
# ----------------------------------------------------------------------------
# Signs the tokens issued by POST /api/auth/login. Generate a strong one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ----------------------------------------------------------------------------
# Frontend (public) — Cloudinary
# ----------------------------------------------------------------------------
# Dashboard → Account details → Cloud name. Safe to expose.
VITE_CLOUDINARY_CLOUD_NAME=
# Suggested destination folder for all uploads (optional).
VITE_CLOUDINARY_UPLOAD_FOLDER=personal-gallery

# ----------------------------------------------------------------------------
# Server-side (secret — NEVER expose to the browser)
# ----------------------------------------------------------------------------
# Cloudinary: Dashboard → Account details → API Key + API Secret (keep private).
# ⚠️ The previous key/secret were leaked in a public commit — regenerate them.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Comma-separated email(s) allowed to become administrators (informational —
# create-admin currently accepts any email you pass it).
ADMIN_EMAILS=

# ----------------------------------------------------------------------------
# Local development only (not used by Vercel)
# ----------------------------------------------------------------------------
PORT=3001
